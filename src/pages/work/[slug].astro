---
import type { GetStaticPaths } from 'astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../lib/site';

export const getStaticPaths = (async () => {
  const entries = await getCollection('work');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}) satisfies GetStaticPaths;

type Props = { entry: CollectionEntry<'work'> };

const { entry } = Astro.props as Props;
const { data } = entry;
const { Content } = await render(entry);

const all = (await getCollection('work')).sort(
  (a: CollectionEntry<'work'>, b: CollectionEntry<'work'>) => a.data.order - b.data.order,
);
const idx = all.findIndex((e: CollectionEntry<'work'>) => e.id === entry.id);
const next = all[(idx + 1) % all.length];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: data.title,
  abstract: data.summary,
  author: { '@type': 'Person', name: site.founder },
  dateCreated: String(data.year),
  keywords: data.stack.join(', '),
  ...(data.liveUrl ? { url: data.liveUrl } : {}),
};
---

<BaseLayout
  title={data.title}
  description={data.summary}
  path={`/work/${entry.id}`}
  jsonLd={jsonLd}
>
  <article class="pt-28 pb-20 md:pt-36 md:pb-28">
    <div class="container-wide">
      <a
        href="/#work"
        class="text-sm font-medium text-[var(--color-fg-soft)] hover:text-[var(--color-accent)]"
      >
        ← All work
      </a>

      <header class="mt-8 max-w-3xl">
        <div class="flex flex-wrap items-center gap-3 text-xs font-semibold tracking-wide text-[var(--color-muted)]">
          <span
            class="rounded-full px-2.5 py-1"
            style={`background: color-mix(in oklab, ${data.accent} 16%, transparent); color: ${data.accent}`}
          >
            {data.status}
          </span>
          <span>{data.category}</span>
          <span>·</span>
          <span>{data.year}</span>
        </div>
        <h1 class="mt-4 font-display text-4xl tracking-tight md:text-6xl">{data.title}</h1>
        <p class="mt-4 text-xl leading-relaxed text-[var(--color-fg-soft)]">{data.tagline}</p>

        <div class="mt-6 flex flex-wrap gap-3">
          {
            data.liveUrl && (
              <a
                href={data.liveUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="rounded-full bg-[var(--color-cta)] px-5 py-2.5 text-sm font-medium text-[var(--color-cta-fg)] transition-opacity hover:opacity-90"
              >
                Visit live site ↗
              </a>
            )
          }
          {
            data.repoUrl && (
              <a
                href={data.repoUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="rounded-full border border-[var(--color-border)] px-5 py-2.5 text-sm font-medium text-[var(--color-fg-soft)] transition-colors hover:border-[var(--color-accent)] hover:text-[var(--color-accent)]"
              >
                View code ↗
              </a>
            )
          }
        </div>
      </header>

      {
        data.cover && (
          <div class="mt-12 overflow-hidden rounded-[var(--radius-card)] border border-[var(--color-border)]">
            <Image
              src={data.cover}
              alt={`${data.title} — screenshot`}
              widths={[600, 1000, 1600]}
              sizes="(min-width: 1024px) 76rem, 100vw"
              class="w-full"
            />
          </div>
        )
      }

      <div class="mt-14 grid gap-12 lg:grid-cols-[1fr_16rem] lg:gap-16">
        <div class="prose-work max-w-none text-[var(--color-fg-soft)]">
          <Content />
        </div>

        <aside class="lg:sticky lg:top-28 lg:self-start">
          <p class="eyebrow">Built for</p>
          <p class="mt-2 text-sm leading-relaxed text-[var(--color-fg-soft)]">{data.audience}</p>
          <p class="eyebrow mt-6">Stack</p>
          <ul class="mt-2 flex flex-wrap gap-1.5">
            {
              data.stack.map((t) => (
                <li class="rounded-md bg-[var(--color-paper-deep)] px-2 py-1 text-[11px] font-medium text-[var(--color-muted)]">
                  {t}
                </li>
              ))
            }
          </ul>
        </aside>
      </div>

      {
        data.gallery.length > 0 && (
          <div class="mt-16 grid gap-6 sm:grid-cols-2">
            {data.gallery.map((img) => (
              <div class="overflow-hidden rounded-[var(--radius-card)] border border-[var(--color-border)]">
                <Image src={img} alt={`${data.title} — detail`} widths={[500, 900]} sizes="(min-width: 640px) 38rem, 100vw" class="w-full" />
              </div>
            ))}
          </div>
        )
      }

      <div class="mt-20 border-t border-[var(--color-border)] pt-8">
        <a href={`/work/${next.id}`} class="group block">
          <span class="eyebrow">Next project</span>
          <span class="mt-2 flex items-baseline gap-3">
            <span class="font-display text-2xl tracking-tight group-hover:text-[var(--color-accent)] md:text-3xl">
              {next.data.title}
            </span>
            <span class="text-[var(--color-muted)] transition-transform group-hover:translate-x-1">→</span>
          </span>
        </a>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .prose-work :global(h2) {
    font-family: var(--font-display);
    font-size: 1.5rem;
    letter-spacing: -0.015em;
    color: var(--color-fg);
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
  }
  .prose-work :global(h2:first-child) {
    margin-top: 0;
  }
  .prose-work :global(p) {
    line-height: 1.75;
    margin-bottom: 1rem;
  }
  .prose-work :global(ul) {
    margin: 1rem 0 1.5rem;
    padding-left: 1.1rem;
    list-style: disc;
  }
  .prose-work :global(li) {
    line-height: 1.7;
    margin-bottom: 0.5rem;
  }
  .prose-work :global(strong) {
    color: var(--color-fg);
    font-weight: 600;
  }
  .prose-work :global(blockquote) {
    border-left: 3px solid var(--color-accent);
    padding-left: 1rem;
    margin: 1.5rem 0;
    color: var(--color-fg);
    font-style: italic;
  }
  .prose-work :global(a) {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
</style>
