---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" path="/404">
  <section class="grid min-h-[70vh] place-items-center px-6 py-28 text-center">
    <div>
      <p class="eyebrow justify-center">404</p>
      <h1 class="mt-4 font-display text-[var(--text-h2)] font-bold leading-[1.03] tracking-[-0.03em]">
        That page isn't here.
      </h1>
      <p class="mx-auto mt-4 max-w-md text-lg leading-relaxed text-[var(--color-fg-soft)]">
        The link may be old, or the page moved. The work is all on the home page.
      </p>
      <a
        href="/"
        class="mt-8 inline-block rounded-full bg-[var(--color-cta)] px-6 py-3 text-sm font-medium text-[var(--color-cta-fg)] transition-opacity hover:opacity-90"
      >
        Back to home
      </a>
    </div>
  </section>
</BaseLayout>
