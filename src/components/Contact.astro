---
import { site } from '../lib/site';
import ContactForm from './ContactForm.tsx';
---

<section id="contact" class="scroll-mt-24 border-t border-[var(--color-border)] py-20 md:py-28">
  <div class="container-wide grid gap-12 lg:grid-cols-[1fr_1fr] lg:gap-16">
    <div class="reveal">
      <p class="eyebrow" data-index="04">Contact</p>
      <h2 class="mt-4 font-display text-[var(--text-h2)] leading-[1.03] tracking-[-0.03em]">
        Building the client list.
      </h2>
      <p class="mt-5 max-w-md text-lg leading-relaxed text-[var(--color-fg-soft)]">
        I'm laying the groundwork for taking on website and app projects. If you
        run a business — especially one serving expats, relocating families or the
        military community in Germany — and you're thinking about a new site, I'd
        like to hear about it.
      </p>

      <div class="mt-8 space-y-3 text-sm">
        <a
          href={`mailto:${site.email}`}
          class="flex items-center gap-3 text-[var(--color-fg-soft)] hover:text-[var(--color-accent)]"
        >
          <span class="mono-tag w-16 text-[10px] uppercase tracking-[0.08em] text-[var(--color-muted)]">Email</span>
          {site.email}
        </a>
        <a
          href={site.socials.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-3 text-[var(--color-fg-soft)] hover:text-[var(--color-accent)]"
        >
          <span class="mono-tag w-16 text-[10px] uppercase tracking-[0.08em] text-[var(--color-muted)]">LinkedIn</span>
          terry-c-lombardi
        </a>
        <a
          href={site.socials.github}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-3 text-[var(--color-fg-soft)] hover:text-[var(--color-accent)]"
        >
          <span class="mono-tag w-16 text-[10px] uppercase tracking-[0.08em] text-[var(--color-muted)]">GitHub</span>
          TerryL1971
        </a>
      </div>
    </div>

    <div class="reveal" style="transition-delay: 80ms">
      <ContactForm client:visible />
    </div>
  </div>
</section>
