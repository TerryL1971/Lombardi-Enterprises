---
import { site } from '../lib/site';

const frameworks = ['Astro', 'Next.js', 'SvelteKit', 'Nuxt', 'React Native', 'Supabase'];
---

<section class="relative overflow-hidden pt-28 pb-16 md:pt-40 md:pb-24">
  {/* soft background wash */}
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 -z-10"
    style="background:
      radial-gradient(58rem 38rem at 12% -12%, color-mix(in oklab, var(--color-accent) 13%, transparent), transparent 70%),
      radial-gradient(46rem 38rem at 108% 4%, color-mix(in oklab, var(--color-accent) 7%, transparent), transparent 62%);"
  >
  </div>

  <div class="container-wide">
    <p class="eyebrow reveal">{site.name} — {site.location}</p>

    <h1
      class="reveal mt-6 max-w-[20ch] font-display font-bold leading-[0.98] tracking-[-0.035em]"
      style="font-size: var(--text-hero); transition-delay: 60ms"
    >
      Websites and apps for businesses that serve<span class="text-[var(--color-accent)]"> people far from home.</span>
    </h1>

    <p
      class="reveal mt-8 max-w-2xl text-lg leading-relaxed text-[var(--color-fg-soft)] md:text-xl"
      style="transition-delay: 120ms"
    >
      I'm {site.founder} — a developer and 20-year business operator based in Germany.
      I build fast, modern sites and apps for expat-, relocation-, and U.S.
      military-facing companies here, and for small businesses that want the same
      standard of craft.
    </p>

    <div
      class="reveal mt-10 flex flex-wrap items-center gap-4"
      style="transition-delay: 180ms"
    >
      <a
        href="#work"
        class="rounded-full bg-[var(--color-cta)] px-6 py-3 text-sm font-medium text-[var(--color-cta-fg)] transition-opacity hover:opacity-90"
      >
        See the work
      </a>
      <a
        href="#about"
        class="text-sm font-medium text-[var(--color-fg-soft)] underline-offset-4 hover:text-[var(--color-accent)] hover:underline"
      >
        About Terry →
      </a>
    </div>

    <div
      class="reveal mt-14 border-t border-[var(--color-border)] pt-5"
      style="transition-delay: 240ms"
    >
      <div class="flex flex-wrap items-center gap-x-2 gap-y-2">
        <span class="mono-tag text-[var(--color-muted)] uppercase tracking-[0.1em]">
          Recent builds use
        </span>
        {
          frameworks.map((f, i) => (
            <>
              {i > 0 && <span aria-hidden="true" class="mono-tag text-[var(--color-border)]">/</span>}
              <span class="mono-tag text-[var(--color-fg-soft)]">{f}</span>
            </>
          ))
        }
      </div>
    </div>
  </div>
</section>
