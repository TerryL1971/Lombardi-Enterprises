---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'work'>;
  index: number;
}

const { entry, index } = Astro.props;
const { data } = entry;
const href = `/work/${entry.id}`;
const delay = Math.min(index, 4) * 60;
---

<a
  href={href}
  class="reveal group flex flex-col overflow-hidden rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] transition-all duration-300 hover:-translate-y-1 hover:border-[color:var(--card-accent)] hover:shadow-[0_20px_50px_-24px_rgba(0,0,0,0.35)]"
  style={`--card-accent: ${data.accent}; transition-delay: ${delay}ms`}
>
  <div class="relative aspect-[16/10] overflow-hidden border-b border-[var(--color-border)]">
    {
      data.cover ? (
        <Image
          src={data.cover}
          alt={`${data.title} — screenshot`}
          widths={[400, 800, 1200]}
          sizes="(min-width: 768px) 40vw, 100vw"
          class="h-full w-full object-cover object-top transition-transform duration-500 group-hover:scale-[1.03]"
        />
      ) : (
        <div
          class="grid h-full w-full place-items-center"
          style={`background:
            radial-gradient(120% 120% at 20% 0%, color-mix(in oklab, ${data.accent} 32%, transparent), transparent 60%),
            radial-gradient(100% 100% at 100% 100%, color-mix(in oklab, ${data.accent} 22%, transparent), transparent 55%),
            var(--color-paper-deep);`}
        >
          <span class="font-display text-2xl font-medium tracking-tight text-[var(--color-ink)]/70">
            {data.title}
          </span>
        </div>
      )
    }
    <span
      class="absolute left-3 top-3 rounded-full bg-[var(--color-bg)]/90 px-2.5 py-1 text-[11px] font-semibold tracking-wide text-[var(--color-fg-soft)] backdrop-blur"
    >
      {data.status}
    </span>
  </div>

  <div class="flex flex-1 flex-col p-5">
    <div class="flex items-center justify-between gap-3">
      <h3 class="font-display text-xl font-medium tracking-tight">{data.title}</h3>
      <span class="shrink-0 text-xs font-medium text-[var(--color-muted)]">{data.category}</span>
    </div>
    <p class="mt-1.5 text-sm font-medium text-[color:var(--card-accent)]">{data.tagline}</p>
    <p class="mt-3 text-sm leading-relaxed text-[var(--color-fg-soft)]">{data.summary}</p>

    <div class="mt-auto flex flex-wrap gap-1.5 pt-5">
      {
        data.stack.slice(0, 4).map((tech) => (
          <span class="rounded-md bg-[var(--color-paper-deep)] px-2 py-1 text-[11px] font-medium text-[var(--color-muted)]">
            {tech}
          </span>
        ))
      }
      {
        data.stack.length > 4 && (
          <span class="rounded-md px-2 py-1 text-[11px] font-medium text-[var(--color-muted)]">
            +{data.stack.length - 4}
          </span>
        )
      }
    </div>
  </div>
</a>
