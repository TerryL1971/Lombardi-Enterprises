---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'work'>;
  index: number;
}

const { entry, index } = Astro.props;
const { data } = entry;
const href = `/work/${entry.id}`;
const delay = Math.min(index, 4) * 60;
const num = String(index + 1).padStart(2, '0');
---

<a
  href={href}
  class="reveal group flex flex-col"
  style={`--card-accent: ${data.accent}; transition-delay: ${delay}ms`}
>
  <div
    class="relative aspect-[16/10] overflow-hidden rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] transition-colors duration-300 group-hover:border-[color:var(--card-accent)]"
  >
    {
      data.cover ? (
        <Image
          src={data.cover}
          alt={`${data.title} — screenshot`}
          widths={[400, 800, 1200]}
          sizes="(min-width: 768px) 40vw, 100vw"
          loading={index < 2 ? 'eager' : 'lazy'}
          class="h-full w-full object-cover object-top transition-transform duration-[600ms] ease-[var(--ease-out-soft)] group-hover:scale-[1.04]"
        />
      ) : (
        <div
          class="grid h-full w-full place-items-center"
          style={`background:
            radial-gradient(120% 120% at 20% 0%, color-mix(in oklab, ${data.accent} 32%, transparent), transparent 60%),
            radial-gradient(100% 100% at 100% 100%, color-mix(in oklab, ${data.accent} 22%, transparent), transparent 55%),
            var(--color-surface);`}
        >
          <span class="font-display text-2xl font-semibold tracking-tight text-[var(--color-fg)]/70">
            {data.title}
          </span>
        </div>
      )
    }
    <span
      class="mono-tag absolute left-3 top-3 rounded-full bg-[var(--color-bg)]/90 px-2.5 py-1 text-[10px] font-medium tracking-[0.06em] text-[var(--color-fg-soft)] uppercase backdrop-blur"
    >
      {data.status}
    </span>
  </div>

  <div class="mt-4 flex flex-1 flex-col">
    <div class="flex items-baseline justify-between gap-3">
      <div class="flex items-baseline gap-2.5">
        <span class="mono-tag text-[var(--color-muted)] tabular-nums">{num}</span>
        <h3 class="font-display text-[var(--text-h3)] font-semibold tracking-[-0.02em]">{data.title}</h3>
      </div>
      <span class="mono-tag shrink-0 text-[10px] text-[var(--color-muted)] uppercase tracking-[0.06em]">{data.category}</span>
    </div>
    <p class="mt-1.5 pl-[calc(1ch+0.625rem)] text-sm font-medium text-[color:var(--card-accent)]">{data.tagline}</p>
    <p class="mt-2.5 pl-[calc(1ch+0.625rem)] text-sm leading-relaxed text-[var(--color-fg-soft)]">{data.summary}</p>

    <div class="mt-4 flex flex-wrap items-center gap-1.5 pl-[calc(1ch+0.625rem)]">
      {
        data.stack.slice(0, 4).map((tech) => (
          <span class="mono-tag rounded-md bg-[var(--color-paper-deep)] px-2 py-1 text-[10px] text-[var(--color-muted)]">
            {tech}
          </span>
        ))
      }
      {
        data.stack.length > 4 && (
          <span class="mono-tag px-1 text-[10px] text-[var(--color-muted)]">
            +{data.stack.length - 4}
          </span>
        )
      }
      <span
        class="mono-tag ml-auto inline-flex items-center gap-1 text-[10px] text-[var(--color-fg-soft)] uppercase tracking-[0.08em] opacity-0 transition-opacity duration-300 group-hover:opacity-100"
      >
        View
        <span aria-hidden="true" class="transition-transform duration-300 group-hover:translate-x-0.5">→</span>
      </span>
    </div>
  </div>
</a>
