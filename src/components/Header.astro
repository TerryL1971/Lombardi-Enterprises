---
import { site, nav } from '../lib/site';
import ThemeToggle from './ThemeToggle.tsx';
---

<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-40 border-b border-transparent transition-colors duration-300"
>
  <div class="container-wide flex h-16 items-center justify-between md:h-20">
    <a href="/" class="group flex items-center gap-2.5" aria-label={`${site.name} — home`}>
      <span
        class="grid h-8 w-8 place-items-center rounded-lg bg-[var(--color-ink)] font-display text-sm font-semibold text-[var(--color-paper)] transition-transform group-hover:-rotate-6"
      >
        LE
      </span>
      <span class="text-[15px] font-semibold tracking-tight">{site.name}</span>
    </a>

    <nav class="hidden items-center gap-8 md:flex" aria-label="Primary">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class="group relative text-sm font-medium text-[var(--color-fg-soft)] transition-colors hover:text-[var(--color-fg)]"
          >
            {item.label}
            <span class="absolute -bottom-1 left-0 h-px w-0 bg-[var(--color-accent)] transition-all duration-300 group-hover:w-full" />
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-3">
      <ThemeToggle client:idle />
      <a
        href="/#contact"
        class="hidden rounded-full bg-[var(--color-ink)] px-4 py-2 text-sm font-medium text-[var(--color-paper)] transition-opacity hover:opacity-90 sm:inline-block"
      >
        Get in touch
      </a>
      <button
        type="button"
        id="menu-toggle"
        class="grid h-9 w-9 place-items-center rounded-full border border-[var(--color-border)] text-[var(--color-fg-soft)] md:hidden"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
      </button>
    </div>
  </div>

  <div
    id="mobile-menu"
    hidden
    class="border-t border-[var(--color-border)] bg-[var(--color-bg)] md:hidden"
  >
    <nav class="container-wide flex flex-col gap-1 py-4" aria-label="Mobile">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class="mobile-link rounded-lg px-2 py-2.5 text-[15px] font-medium text-[var(--color-fg-soft)] hover:bg-[var(--color-paper-deep)] hover:text-[var(--color-fg)]"
          >
            {item.label}
          </a>
        ))
      }
      <a
        href="/#contact"
        class="mobile-link mt-2 rounded-full bg-[var(--color-ink)] px-4 py-2.5 text-center text-sm font-medium text-[var(--color-paper)]"
      >
        Get in touch
      </a>
    </nav>
  </div>
</header>

<script>
  const header = document.getElementById('site-header');
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');

  // Solidify the header background once the page is scrolled.
  const onScroll = () => {
    if (!header) return;
    const scrolled = window.scrollY > 8;
    header.classList.toggle('border-[var(--color-border)]', scrolled);
    header.classList.toggle('bg-[var(--color-bg)]/85', scrolled);
    header.classList.toggle('backdrop-blur-md', scrolled);
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  const closeMenu = () => {
    if (!menu || !toggle) return;
    menu.hidden = true;
    toggle.setAttribute('aria-expanded', 'false');
    toggle.setAttribute('aria-label', 'Open menu');
  };

  toggle?.addEventListener('click', () => {
    if (!menu) return;
    const open = menu.hidden;
    menu.hidden = !open;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  });

  menu?.querySelectorAll('.mobile-link').forEach((link) => {
    link.addEventListener('click', closeMenu);
  });
</script>
