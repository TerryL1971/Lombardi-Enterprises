---
import { getCollection } from 'astro:content';
import WorkCard from './WorkCard.astro';

const entries = (await getCollection('work')).sort(
  (a, b) => a.data.order - b.data.order,
);

const liveCount = entries.filter((e) => e.data.status === 'Live').length;
---

<section id="work" class="scroll-mt-24 border-t border-[var(--color-border)] py-20 md:py-28">
  <div class="container-wide">
    <div class="reveal flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="eyebrow" data-index="01">Selected work</p>
        <h2 class="mt-4 max-w-2xl font-display text-[var(--text-h2)] leading-[1.02] tracking-[-0.03em]">
          Nine builds across five frameworks.
        </h2>
      </div>
      <p class="max-w-sm text-sm leading-relaxed text-[var(--color-fg-soft)]">
        Marketing sites, web apps, storefronts and a mobile app — {liveCount} live,
        the rest concept builds with public code. Most solve a version of the same
        problem: helping people navigate life in a country that isn't theirs yet.
      </p>
    </div>

    <div class="mt-14 grid gap-x-6 gap-y-12 sm:grid-cols-2">
      {entries.map((entry, i) => <WorkCard entry={entry} index={i} />)}
    </div>
  </div>
</section>
