---
const services = [
  {
    title: 'Marketing sites',
    body: 'Fast, findable sites that load as static HTML and read cleanly for search and AI answer engines. Astro, with interactive parts added only where they earn it.',
  },
  {
    title: 'Web apps',
    body: 'Auth, dashboards, listings, admin tools — built on Next.js and Supabase, deployed serverless, with an admin experience a non-technical owner can actually run.',
  },
  {
    title: 'E-commerce',
    body: 'Storefronts on Stripe with a real CMS behind them, so the owner edits their own catalog and prices are validated server-side, not trusted from the browser.',
  },
  {
    title: 'Mobile apps',
    body: 'Cross-platform apps in Expo / React Native when a project genuinely belongs on a phone — with secrets kept server-side and a build that survives real-device testing.',
  },
];

const steps = [
  ['01', 'Discovery', 'A conversation about the business, the customer, and what the site actually has to do. No templates picked yet.'],
  ['02', 'Design &amp; build', 'A visual direction, then the build in weekly previews you can click through — not one big reveal at the end.'],
  ['03', 'Launch &amp; support', 'Deploy, wire up analytics and SEO basics, hand over the keys, and stay reachable for changes.'],
];
---

<section id="approach" class="scroll-mt-24 border-t border-[var(--color-border)] py-20 md:py-28">
  <div class="container-wide">
    <div class="reveal">
      <p class="eyebrow" data-index="02">Approach</p>
      <h2 class="mt-4 max-w-3xl font-display text-[var(--text-h2)] leading-[1.03] tracking-[-0.03em]">
        A business operator who codes — so the site is judged on what it does, not
        how it looks in a screenshot.
      </h2>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-[var(--color-fg-soft)]">
        Twenty years running sales and operations before writing production code
        changes what you build. I care about the enquiry that turns into a
        customer, the page that ranks, the owner who can update their own content.
      </p>
    </div>

    <div class="mt-14 grid gap-px overflow-hidden rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-border)] sm:grid-cols-2">
      {
        services.map((s, i) => (
          <div class="reveal bg-[var(--color-surface)] p-6 md:p-7">
            <span class="mono-tag text-[var(--color-muted)] tabular-nums">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="mt-3 font-display text-lg font-semibold tracking-[-0.02em]">{s.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-[var(--color-fg-soft)]">{s.body}</p>
          </div>
        ))
      }
    </div>

    <div class="mt-16 reveal">
      <p class="eyebrow">How a project runs</p>
      <div class="mt-8 grid gap-px overflow-hidden rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-border)] md:grid-cols-3">
        {
          steps.map(([num, title, body]) => (
            <div class="bg-[var(--color-surface)] p-6">
              <span class="mono-tag text-[var(--color-accent)] tabular-nums">{num}</span>
              <h4 class="mt-3 font-display text-lg font-semibold tracking-[-0.02em]" set:html={title} />
              <p class="mt-2 text-sm leading-relaxed text-[var(--color-fg-soft)]" set:html={body} />
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
